{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Raylib",
            "command": "gcc",
            "args": [
                "main.c",
                "-Iinclude",
                "-Llib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-o",
                "jogo.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}